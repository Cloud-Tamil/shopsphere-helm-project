# ==============================================================================
# ShopSphere Platform - Global Environment Configuration (.env.example)
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION PORTS (Customizable to avoid local port conflicts)
# ------------------------------------------------------------------------------
# Jenkins CI/CD Controller Web UI (http://localhost:${JENKINS_PORT})
JENKINS_PORT=8080

# Jenkins Inbound Agent communication port
JENKINS_AGENT_PORT=50000

# ShopSphere Storefront Nginx SPA (http://localhost:${FRONTEND_PORT})
FRONTEND_PORT=8085

# ShopSphere Backend REST API microservice (http://localhost:${BACKEND_PORT})
BACKEND_PORT=5000

# PostgreSQL Database (localhost:${POSTGRES_PORT})
POSTGRES_PORT=5432

# Redis Cache Service (localhost:${REDIS_PORT})
REDIS_PORT=6379

# ArgoCD Web UI (Optional local port forwarding)
ARGOCD_PORT=8090

# ------------------------------------------------------------------------------
# JENKINS CONTROLLER CREDENTIALS & AUTOMATION (JCasC)
# ------------------------------------------------------------------------------
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin
JENKINS_URL=http://localhost:8080/

# ------------------------------------------------------------------------------
# MICROSERVICES & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=1.0.0
DEFAULT_CURRENCY=USD
ENABLE_DISCOUNTS=true
LOG_LEVEL=info
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# DATABASE & CACHE CONNECTION SETTINGS
# ------------------------------------------------------------------------------
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=secretpass123
POSTGRES_DB=shopsphere_db
DATABASE_URL=postgres://shopsphere:secretpass123@postgres:5432/shopsphere_db
REDIS_HOST=redis:6379

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET=super_secure_jwt_secret_token_128bit_shopsphere_key
PAYMENT_GATEWAY_KEY=pk_test_shopsphere_mock_stripe_key
ADMIN_API_KEY=adm_key_shopsphere_9942a188f

# ------------------------------------------------------------------------------
# KUBERNETES & INGRESS NETWORKING
# ------------------------------------------------------------------------------
INGRESS_DOMAIN=dev.shopsphere.local
K8S_NAMESPACE=shopsphere-dev
